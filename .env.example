# Copy to .env in repo root for Expo app.config.js (required for Early Access waitlist)
# Use the same Supabase project + publishable anon key as web/.env.local (VITE_SUPABASE_*).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional — OpenRouter free models for AI exposure explanations (score is always computed locally)
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-key

# Optional — O*NET Web Services credentials (local occupation index used when absent)
EXPO_PUBLIC_ONET_USERNAME=
EXPO_PUBLIC_ONET_PASSWORD=
