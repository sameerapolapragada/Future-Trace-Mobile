# Supabase (Vite — client-safe keys only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Stripe (dev server only — never expose secret keys with a VITE_ prefix)
# STRIPE_SECRET_KEY=sk_test_...
# Optional — use your Stripe Dashboard price IDs (dev checkout uses inline $1.99 / $9.99 pricing if unset):
# STRIPE_XRAY_PRICE_ID=price_...
# STRIPE_RADAR_PRICE_ID=price_...
# SUPABASE_SERVICE_ROLE_KEY=...  # optional; unlocks Radar entitlement after subscription checkout in dev

# Future-Trace BFF — required in production/staging (HTTPS).
# Example: https://api.futuretrace.com
# The BFF must allow CORS from your web origin only (e.g. https://app.futuretrace.com).
# VITE_API_BASE_URL=https://api.futuretrace.com

# Error monitoring (optional — omit in local dev)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
