{
  "name": "future-trace-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan -c",
    "start:tunnel": "expo start --tunnel -c",
    "start:ios": "expo start --ios -c",
    "start:android": "expo start --android -c",
    "start:reset": "rm -rf .expo && expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:web": "npm run dev --prefix web",
    "dev:bff": "npm run dev --prefix bff",
    "dev:full": "npm run dev:full --prefix web",
    "test:ai": "npm run test --prefix bff"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@supabase/supabase-js": "^2.50.2",
    "expo": "^54",
    "expo-constants": "~18.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^56.0.15",
    "dotenv": "^16.6.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
