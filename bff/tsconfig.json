{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@ft/ai": ["../lib/ai/index.ts"],
      "@ft/ai/*": ["../lib/ai/*"]
    }
  },
  "include": ["src", "../lib/ai", "../lib/shared/mvpFlags.ts"]
}
